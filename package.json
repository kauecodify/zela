{
  "name": "zela-nacional",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema Nacional de Zeladoria Urbana Compartilhada via IA - Pré-Seed R$ 300M B2G",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*",
    "ai/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "start": "turbo run start",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "docker:up": "docker-compose -f docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker-compose.yml down",
    "infra:plan": "cd infra/terraform/environments/production && terraform plan",
    "infra:apply": "cd infra/terraform/environments/production && terraform apply",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
