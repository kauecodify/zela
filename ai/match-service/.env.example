# Environment Configuration for MATCH Service

# Environment
ENVIRONMENT=development
DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=3003
WORKERS=4
LOG_LEVEL=INFO

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/zela_nacional?schema=public

# Authentication
API_KEY=zela-match-secret-change-in-production
JWT_SECRET=zela-secret-key-change-in-production

# Integration URLs
ROUTING_SERVICE_URL=http://routing-service:3002
ANALYTICS_SERVICE_URL=http://analytics-service:3008

# Model Configuration
MODEL_DIR=./models
USE_GPU=False

# Thresholds
CONFIDENCE_THRESHOLD=0.7
HUMAN_REVIEW_THRESHOLD=0.6

# Cache Configuration
CACHE_ENABLED=True
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT=1000

# Guardrails
MAX_INPUT_LENGTH=10000
MAX_BATCH_SIZE=100
