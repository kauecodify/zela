# Server Configuration
NODE_ENV=development
PORT=3002

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/zela_nacional?schema=public
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/zela_nacional?schema=public

# JWT Configuration (para validacao de tokens)
JWT_SECRET=zela-secret-key-change-in-production

# MATCH API Configuration
MATCH_API_URL=http://match-service:3003/api/match
ENABLE_EXTERNAL_MATCH=false

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug
