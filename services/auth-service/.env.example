# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/zela_nacional?schema=public
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/zela_nacional?schema=public

# JWT Configuration
JWT_SECRET=zela-secret-key-change-in-production
JWT_REFRESH_SECRET=zela-refresh-secret-change-in-production
JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug
